                    "maximum": 9223372036854775807,
                    "minimum": -9223372036854775808,
                    "type": "integer"
                },
                "is_ready": {
                    "type": "boolean"
                },
                "lag_seconds": {
                    "maximum": 9223372036854775807,
                    "minimum": -9223372036854775808,
                    "type": "integer"
                },
                "slot": {
                    "type": "integer"
                },
                "source": {
                    "type": "string"
                }
            },
            "required": [

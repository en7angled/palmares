        "EpochParamsSummary": {
            "description": "The protocol parameters a client needs to audit a published tally. Threshold lists are (name, value) pairs under db-sync's own column names, so any of them can be looked up in palmares.thresholds. `gov_action_lifetime` is the parameter, not the voting window: the ledger sets expiration = proposed_epoch + lifetime + 1.",
            "properties": {
                "committee_max_term_length": {
                    "maximum": 9223372036854775807,
                    "minimum": -9223372036854775808,
                    "type": "integer"
                },
                "committee_min_size": {
                    "maximum": 9223372036854775807,
                    "minimum": -9223372036854775808,
                    "type": "integer"
                },
                "drep_activity": {
                    "maximum": 9223372036854775807,
                    "minimum": -9223372036854775808,
                    "type": "integer"
                },
                "drep_deposit": {
                    "type": "integer"
                },
                "drep_thresholds": {
                    "items": {
                        "items": [
                            {
                                "type": "string"
                            },
                            {
                                "format": "double",
                                "type": "number"
                            }
                        ],
                        "maxItems": 2,
                        "minItems": 2,
                        "type": "array"
                    },
                    "type": "array"
                },
                "epoch": {
                    "maximum": 9223372036854775807,
                    "minimum": -9223372036854775808,
                    "type": "integer"
                },
                "gov_action_deposit": {
                    "type": "integer"
                },
                "gov_action_lifetime": {
                    "maximum": 9223372036854775807,
                    "minimum": -9223372036854775808,
                    "type": "integer"
                },
                "pool_thresholds": {
                    "items": {
                        "items": [
                            {
                                "type": "string"
                            },
                            {
                                "format": "double",
                                "type": "number"
                            }
                        ],
                        "maxItems": 2,
                        "minItems": 2,
                        "type": "array"
                    },
                    "type": "array"
                }
            },
            "required": [
                "epoch",
                "gov_action_lifetime",
                "gov_action_deposit",
                "drep_deposit",
                "drep_activity",
                "committee_min_size",
                "committee_max_term_length",
                "drep_thresholds",
                "pool_thresholds"
            ],
            "type": "object"
        },
        "MetricFormula": {
            "description": "One published formula. `sql` is the statement the server actually executes, inlined from the same embed the query path reads, so the documented formula cannot drift from the served number. Exactly one of `sql_file` and `sql_object` is set, so every formula_id resolves to something a reader can go and look at. `params` names the positional placeholders in bind order.",
            "properties": {
                "denominator": {
                    "type": "string"
                },
                "edge_cases": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "expression": {
                    "type": "string"
                },
                "field": {
                    "type": "string"
                },
                "formula_id": {
                    "type": "string"
                },
                "inputs": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "name": {
                    "type": "string"
                },
                "null_when": {
                    "type": "string"
                },
                "params": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "spec": {
                    "type": "string"
                },
                "sql": {
                    "type": "string"
                },
                "sql_file": {
                    "type": "string"
                },
                "sql_object": {
                    "type": "string"
                },
                "version": {
                    "maximum": 9223372036854775807,
                    "minimum": -9223372036854775808,
                    "type": "integer"
                }
            },
            "required": [
                "formula_id",
                "name",
                "field",
                "expression",
                "inputs",
                "edge_cases",
                "params",
                "spec",
                "version"
            ],
            "type": "object"
        },
        "Page": {
            "properties": {
                "items": {
                    "items": {
                        "$ref": "#/definitions/DRepSummary"
                    },
                    "type": "array"
                },
                "limit": {
                    "maximum": 9223372036854775807,
                    "minimum": -9223372036854775808,
                    "type": "integer"
                },
                "next_cursor": {
                    "type": "string"
                },
                "offset": {
                    "maximum": 9223372036854775807,
                    "minimum": -9223372036854775808,
                    "type": "integer"
                },
                "total": {
                    "maximum": 9223372036854775807,
                    "minimum": -9223372036854775808,
                    "type": "integer"
                }
            },
            "required": [
                "items",
                "limit",
                "offset"
            ],
            "type": "object"
        },
        "ServiceProbeStatus": {
            "properties": {
                "service": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "timestamp": {
                    "type": "string"
                },
                "version": {
                    "type": "string"
                }
            },
            "required": [
                "status",
                "service",
                "version",
                "timestamp"
            ],
            "type": "object"
        },
        "StatusResponse": {
            "description": "Service identity, chain freshness and protocol parameters in one request.",
            "properties": {
                "epoch_params": {
                    "$ref": "#/definitions/EpochParamsSummary"
                },
                "governance": {
                    "$ref": "#/definitions/SyncStatus"
                },
                "network": {
                    "type": "string"
                }

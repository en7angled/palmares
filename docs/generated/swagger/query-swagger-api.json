        "UTCTime": {
            "example": "2016-07-22T00:00:00Z",
            "format": "yyyy-mm-ddThh:MM:ssZ",
            "type": "string"
        }
    },
    "info": {
        "description": "Read-only queries over the Cardano governance record: DReps, governance actions, votes, delegations, the constitutional committee and treasury withdrawals. Every row comes from a view over cardano-db-sync — there is no projection table and no second derivation — and every published metric carries the id of the formula that produced it, resolvable at /metrics/formulas.",
        "license": {
            "name": "Apache-2.0"
        },
        "title": "Palmares Query API",
        "version": "0.1.0"
    },
    "paths": {
        "/dreps": {
            "get": {
                "description": "Registered delegate representatives with their track record: participation, rationale coverage, vote latency, voting power, delegator count and age. Default ordering is voting_power descending, because this list is what a delegator chooses from. Statuses default to the two registered ones (active and inactive) -- preprod has 511 retired DReps against 294 registered, so including them by default would make the first page mostly useless; ask for them with status=retired. The two reserved ledger options (drep_always_abstain, drep_always_no_confidence) are never listed: they hold stake but no credential, and are published by /drep-power instead.",
                "parameters": [
                    {
                        "in": "header",
                        "name": "Accept",
                        "required": false,
                        "type": "string"
                    },
                    {
                        "in": "query",
                        "maximum": 9223372036854775807,
                        "minimum": -9223372036854775808,
                        "name": "limit",
                        "required": false,
                        "type": "integer"
                    },
                    {
                        "in": "query",
                        "maximum": 9223372036854775807,
                        "minimum": -9223372036854775808,
                        "name": "offset",
                        "required": false,
                        "type": "integer"
                    },
                    {
                        "collectionFormat": "multi",
                        "in": "query",
                        "items": {
                            "enum": [
                                "active",
                                "inactive",
                                "retired",
                                "reserved"
                            ],
                            "type": "string"
                        },
                        "name": "status",
                        "type": "array"
                    },
                    {
                        "collectionFormat": "multi",
                        "in": "query",
                        "items": {
                            "enum": [
                                "valid",
                                "invalid_schema",
                                "hash_mismatch",
                                "oversized",
                                "unreachable",
                                "inline",
                                "not_fetched"
                            ],
                            "type": "string"
                        },
                        "name": "anchor_status",
                        "type": "array"
                    },
                    {
                        "in": "query",
                        "name": "has_script",
                        "required": false,
                        "type": "boolean"
                    },
                    {
                        "format": "int64",
                        "in": "query",
                        "maximum": 9223372036854775807,
                        "minimum": -9223372036854775808,
                        "name": "min_voting_power",
                        "required": false,
                        "type": "integer"
                    },
                    {
                        "format": "int64",
                        "in": "query",
                        "maximum": 9223372036854775807,
                        "minimum": -9223372036854775808,
                        "name": "max_voting_power",
                        "required": false,
                        "type": "integer"
                    },
                    {
                        "in": "query",
                        "maximum": 9223372036854775807,
                        "minimum": -9223372036854775808,
                        "name": "min_delegators",
                        "required": false,
                        "type": "integer"
                    },
                    {
                        "format": "double",
                        "in": "query",
                        "name": "min_participation_rate",
                        "required": false,
                        "type": "number"
                    },
                    {
                        "format": "double",
                        "in": "query",
                        "name": "min_rationale_rate",
                        "required": false,
                        "type": "number"
                    },
                    {
                        "format": "yyyy-mm-ddThh:MM:ssZ",
                        "in": "query",
                        "name": "registered_before",
                        "required": false,
                        "type": "string"
                    },
                    {
                        "format": "yyyy-mm-ddThh:MM:ssZ",
                        "in": "query",
                        "name": "registered_after",
                        "required": false,
                        "type": "string"
                    },
                    {
                        "in": "query",
                        "maximum": 9223372036854775807,
                        "minimum": -9223372036854775808,
                        "name": "min_age_days",
                        "required": false,
                        "type": "integer"
                    },
                    {
                        "in": "query",
                        "name": "voted_on",
                        "required": false,
                        "type": "string"
                    },
                    {
                        "in": "query",
                        "name": "not_voted_on",
                        "required": false,
                        "type": "string"
                    },
                    {
                        "in": "query",
                        "name": "language",
                        "required": false,
                        "type": "string"
                    },
                    {
                        "in": "query",
                        "maximum": 9223372036854775807,
                        "minimum": -9223372036854775808,
                        "name": "active_in_epoch",
                        "required": false,
                        "type": "integer"
                    },
                    {
                        "in": "query",
                        "name": "q",
                        "required": false,
                        "type": "string"
                    },
                    {
                        "enum": [
                            "id",
                            "voting_power",
                            "delegator_count",
                            "participation_rate",
                            "rationale_rate",
                            "registered_at",
                            "votes_cast",
                            "name"
                        ],
                        "in": "query",
                        "name": "order_by",
                        "required": false,
                        "type": "string"
                    },
                    {
                        "enum": [
                            "asc",
                            "desc"
                        ],
                        "in": "query",
                        "name": "sort_order",
                        "required": false,
                        "type": "string"
                    }
                ],
                "produces": [
                    "application/json;charset=utf-8",
                    "text/csv;charset=utf-8"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "schema": {
                            "$ref": "#/definitions/Page"
                        }
                    },
                    "400": {
                        "description": "Invalid query parameters; the body carries a machine-readable `code`"
                    },
                    "404": {
                        "description": "Well-formed request naming something that does not exist"
                    },
                    "503": {
                        "description": "Index not ready: too far behind, no ledger state, or the wrong network"
                    }
                },
                "summary": "DReps"
            }
        },
        "/health": {
            "get": {
                "description": "Returns the health status of the service",
                "produces": [
                    "application/json;charset=utf-8"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "schema": {
                            "$ref": "#/definitions/ServiceProbeStatus"
                        }
                    },
                    "400": {
                        "description": "Invalid query parameters; the body carries a machine-readable `code`"
                    },
                    "404": {
                        "description": "Well-formed request naming something that does not exist"
                    },
                    "503": {
                        "description": "Index not ready: too far behind, no ledger state, or the wrong network"
                    }
                },
                "summary": "Health Check"
            }
        },
        "/metrics/formulas": {
            "get": {
                "description": "Every number this API publishes carries the id of the formula that produced it, and this endpoint resolves those ids: what the formula means, what its denominator counts, when it is null rather than zero, which db-sync tables it reads, its edge cases, and - for the six that have one - the exact SQL statement the server executes, inlined. Those statements are read out of the same embed the query path runs, so the published formula and the served number cannot disagree.",
                "produces": [
                    "application/json;charset=utf-8"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "schema": {
                            "items": {
                                "$ref": "#/definitions/MetricFormula"
                            },
                            "type": "array"
                        }
                    },
                    "400": {
                        "description": "Invalid query parameters; the body carries a machine-readable `code`"
                    },
                    "404": {
                        "description": "Well-formed request naming something that does not exist"
                    },
                    "503": {
                        "description": "Index not ready: too far behind, no ledger state, or the wrong network"
                    }
                },
                "summary": "Published metric formulas"
            }
        },
        "/ready": {
            "get": {
                "description": "Returns the readiness status of the service",
                "produces": [
                    "application/json;charset=utf-8"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "schema": {
                            "$ref": "#/definitions/ServiceProbeStatus"
                        }
                    },
                    "400": {
                        "description": "Invalid query parameters; the body carries a machine-readable `code`"
                    },
                    "404": {
                        "description": "Well-formed request naming something that does not exist"
                    },
                    "503": {
                        "description": "Index not ready: too far behind, no ledger state, or the wrong network"
                    }
                },
                "summary": "Readiness Check"
            }
        },
        "/status": {
            "get": {
                "description": "What this instance serves, how far behind the chain its index is, and the protocol parameters its published numbers mean something against. `governance.is_ready` is the same verdict /ready gives, so a client needs one request rather than two that can disagree.",
                "produces": [
                    "application/json;charset=utf-8"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "schema": {
                            "$ref": "#/definitions/StatusResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid query parameters; the body carries a machine-readable `code`"
                    },
                    "404": {
                        "description": "Well-formed request naming something that does not exist"
                    },
                    "503": {
                        "description": "Index not ready: too far behind, no ledger state, or the wrong network"
                    }
                },
                "summary": "Service and chain status"
            }
        }
    },
    "swagger": "2.0"
}
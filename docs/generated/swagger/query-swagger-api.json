        "SyncStatus": {
            "description": "How far behind the chain this index is. `lag_seconds` is measured from the tip block's time; `is_ready` is /ready's own verdict.",
            "properties": {
                "block_time": {
                    "$ref": "#/definitions/UTCTime"
                },
